{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "files": {
    "includes": [
      "src/**/*.ts",
      "src/**/*.tsx",
      "src/**/*.mjs",
      "tests/**/*.ts",
      "tests/**/*.tsx",
      "evals/**/*.ts",
      "demos/**/*.ts",
      "scripts/**/*.ts",
      "scripts/**/*.tsx",
      "scripts/**/*.mjs",
      "docs/sherlock-system-atlas/**/*.ts",
      "docs/sherlock-system-atlas/**/*.tsx",
      "bin/**/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  }
}
