{
  "name": "evidence-collection-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "native",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "evals/runners/loadTask.ts",
    "evals/runners/report.ts",
    "evals/metrics/metrics.ts",
    "evals/types.ts",
    "tsconfig.json"
  ],
  "bin": {
    "sherlock": "bin/sherlock.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "evals": "tsx evals/runners/cli.ts",
    "analyze:browser-batch": "tsx evals/analysis/browserBatchCli.ts",
    "agent": "tsx src/cli/repl.ts",
    "login": "tsx src/cli/login.ts",
    "sherlock": "node bin/sherlock.mjs",
    "build:quicklook": "native/quicklook/build.sh"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@date-fns/tz": "1.2.0",
    "@langfuse/otel": "5.10.0",
    "@langfuse/tracing": "5.10.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.221.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "csv-stringify": "6.6.0",
    "date-fns": "4.1.0",
    "ink": "^7.1.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
