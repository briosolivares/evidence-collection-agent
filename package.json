{
  "name": "evidence-collection-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "native",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/tui/developmentEvals.ts",
    "!src/tui/bridge/evalRuntime.ts",
    "!src/tui/bridge/evalSession.ts",
    "!src/tui/components/EvalsMenu.tsx",
    "!src/tui/components/EvalsLiveRegion.tsx",
    "tsconfig.json"
  ],
  "bin": {
    "sherlock": "bin/sherlock.mjs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "evals": "tsx --env-file-if-exists=.env evals/runners/cli.ts",
    "agent": "tsx src/cli/repl.ts",
    "login": "tsx src/cli/login.ts",
    "smoke:browserbase": "tsx --env-file-if-exists=.env scripts/browserbaseSmoke.ts",
    "sherlock": "node bin/sherlock.mjs",
    "build:quicklook": "native/quicklook/build.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@browserbasehq/sdk": "2.18.0",
    "@langfuse/otel": "5.10.0",
    "@langfuse/tracing": "5.10.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "date-fns": "4.1.0",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  }
}
