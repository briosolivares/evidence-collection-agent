# Sherlock / evidence-collection-agent environment.
#
# Dev checkout: copy to .env at the repo root — sherlock loads it
# automatically; other entry points take it explicitly:
#   npx tsx --env-file=.env src/cli/repl.ts
# Installed CLI: copy to ~/.sherlock/.env (or ./.env in the directory
# you launch from; sherlock tries ./.env first, then ~/.sherlock/.env).

# Required: Claude API access (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Optional: Langfuse tracing — a clean no-op when unset.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
#LANGFUSE_BASE_URL=

# Optional: authenticated GitHub API for the eval oracles; without it
# the unauthenticated 60 requests/hour limit applies.
GITHUB_TOKEN=

# --- Browser runtime -------------------------------------------------
#
# Which browser every entry point drives: local Chrome (the default), or
# Browserbase-hosted remote Chrome. Selection is deliberately EXPLICIT —
# holding a Browserbase key does not start billable remote sessions until
# you ask for them here. `local` is always the fallback, and the test
# suite is hermetic on local Chrome either way.
#SHERLOCK_BROWSER_PROVIDER=browserbase

# Required when the provider is browserbase.
BROWSERBASE_API_KEY=

# The persistent Browserbase Context holding your Google and X logins.
# Created and written here for you by `npm run login`; leave it blank
# until then. Without it, remote sessions simply start signed out — and
# the authenticated eval lane refuses to run rather than pretend.
#BROWSERBASE_CONTEXT_ID=
